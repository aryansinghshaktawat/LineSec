# LineSec 2+ Environment Configuration Template

# Server & Mode
DEV_MODE=true
API_SECRET_KEY=change-this-to-a-secure-random-secret-in-production

# Database (PostgreSQL for production, SQLite for local dev)
DATABASE_URL=postgresql://linesec_user:secure_password@localhost:5432/linesec_db

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# AI Integration
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# GitHub Remediation Microservice
GITHUB_TOKEN=
TARGET_REPO=

# Workspace Sandbox
WORKSPACE_ROOT=/tmp/linesec_workspaces
